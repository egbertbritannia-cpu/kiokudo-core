{
  "name": "kiokudo-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "staging:local": "tsx scripts/seed-local-staging.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.38.4",
    "ts-fsrs": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
