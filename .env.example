# Server-only API token; use a unique long random value.
KIOKUDO_SERVICE_TOKEN=replace-this-with-a-long-random-value
PORT=4000
HOST=127.0.0.1

# NO STAGING DB BY DEFAULT.
# KIOKUDO_DATABASE_SCOPE=staging
# KIOKUDO_DATABASE_URL=file:./staging-rehearsal.db
# KIOKUDO_EXPECTED_STAGING_MARKER=kiokudo-local-json-fixture-not-production-v1
#
# Separate remote Turso STAGING needs an independently verified DB identity
# provisioned through its secure admin interface, and a unique random marker.
# KIOKUDO_DATABASE_URL=libsql://STAGING-db.turso.io
# KIOKUDO_DATABASE_AUTH_TOKEN=...
# KIOKUDO_EXPECTED_STAGING_MARKER=...  (random 24+ chars, NOT fixture marker)
# TURSO_DATABASE_URL=...  (optional known production URL for extra mismatch check)

# Phase 01 — strict single-owner dataset authorization (staging only).
# This must match the signed subject from kiokudo-web.
KIOKUDO_OWNER_SUBJECT=owner_kiokudo
# Shared Web/Core assertion HMAC key; independent of service bearer and session key.
KIOKUDO_INTERNAL_ASSERTION_KEY=replace-with-independent-32-plus-random-characters
# Set true ONLY after confirming this staging database belongs to that single owner.
# Not equivalent to per-row multi-tenant migration.
KIOKUDO_SINGLE_OWNER_DATASET_ACK=false
# Browser review writes stay disabled until independent auth and integration review.
KIOKUDO_STAGING_WRITE_ENABLED=false
# Phase 01-04 server-side write gates. Require verified isolated staging.
# Operator-only explicit import of reviewed JPD133 source->existing Core card mapping.
KIOKUDO_MAPPING_IMPORT_ENABLED=false
# Apply migrations/20261010_p04_learning.sql ONLY to verified nonproduction staging.
