# Server-only API token; use a unique long random value.
KIOKUDO_SERVICE_TOKEN=replace-this-with-a-long-random-value
PORT=4000
HOST=127.0.0.1

# NO STAGING DB BY DEFAULT.
# KIOKUDO_DATABASE_SCOPE=staging
# KIOKUDO_DATABASE_URL=file:./staging-rehearsal.db
# KIOKUDO_EXPECTED_STAGING_MARKER=kiokudo-local-json-fixture-not-production-v1
#
# Separate remote Turso STAGING needs an independently verified DB identity
# provisioned through its secure admin interface, and a unique random marker.
# KIOKUDO_DATABASE_URL=libsql://STAGING-db.turso.io
# KIOKUDO_DATABASE_AUTH_TOKEN=...
# KIOKUDO_EXPECTED_STAGING_MARKER=...  (random 24+ chars, NOT fixture marker)
# TURSO_DATABASE_URL=...  (optional known production URL for extra mismatch check)
