# For local bootstrap. Never commit real tokens.
KIOKUDO_SERVICE_TOKEN=replace-this-with-a-long-random-value
PORT=4000
HOST=127.0.0.1

# Stage 2: explicit staging ONLY; leave unset to run without DB.
# KIOKUDO_DATABASE_SCOPE=staging
# KIOKUDO_DATABASE_URL=file:./kiokudo-staging.db
# For separate Turso STAGING instance (not production):
# KIOKUDO_DATABASE_URL=libsql://staging-database.turso.io
# KIOKUDO_DATABASE_AUTH_TOKEN=...
